{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://burnbar.ai/schemas/rollback-drill-receipt.schema.json",
  "title": "OpenBurnBar Cloud Run rollback drill receipt",
  "description": "Redaction-safe receipt for a Cloud Run revision-pin rollback drill. A live receipt proves the full round trip: the target's image was present, 100% traffic was pinned to it and read back, it answered a health probe with 2xx, and the pre-drill traffic was restored and read back. Project IDs, resource paths, image references, service URLs, and operator identities are intentionally not part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "generatedAt",
    "mode",
    "liveDrill",
    "ok",
    "drill",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "openburnbar.rollback-drill-receipt.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "liveDrill": {
      "type": "boolean"
    },
    "ok": {
      "const": true
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "serviceName",
        "region",
        "targetRevision",
        "trafficPercent",
        "healthProbe"
      ],
      "properties": {
        "kind": {
          "const": "cloud-run-revision-pin"
        },
        "serviceName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Cloud Run service name only; never a projects/... resource path or a host."
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]+-[a-z0-9]+$",
          "description": "Cloud Run region only."
        },
        "targetRevision": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Cloud Run revision name only."
        },
        "trafficPercent": {
          "const": 100
        },
        "healthProbe": {
          "enum": [
            "not-run",
            "passed",
            "warning"
          ]
        },
        "imagePreflight": {
          "const": "verified",
          "description": "The target revision's image (by the digest Cloud Run pulls) was found in Artifact Registry before any traffic change."
        },
        "previousServing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "latest",
                "revision"
              ],
              "description": "latest: 100% followed the LATEST revision before the drill; revision: 100% was pinned to one revision."
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "description": "Revision name serving 100% before the drill."
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "revision"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "revision"
            ]
          }
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "confirmed"
          ],
          "properties": {
            "mode": {
              "enum": [
                "latest",
                "revision"
              ]
            },
            "confirmed": {
              "const": true,
              "description": "A live traffic readback after the restore matched the pre-drill serving mode."
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionListLoaded",
        "trafficPinned",
        "liveGcloudSession"
      ],
      "properties": {
        "revisionListLoaded": {
          "const": true
        },
        "trafficPinned": {
          "type": "boolean"
        },
        "liveGcloudSession": {
          "type": "boolean"
        },
        "imageVerified": {
          "type": "boolean"
        },
        "trafficRestored": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixture"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "liveDrill": {
            "const": false
          },
          "checks": {
            "properties": {
              "liveGcloudSession": {
                "const": false
              },
              "trafficPinned": {
                "const": false
              },
              "imageVerified": {
                "const": false
              },
              "trafficRestored": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "liveDrill": {
            "const": true
          },
          "drill": {
            "required": [
              "imagePreflight",
              "previousServing",
              "restore"
            ],
            "properties": {
              "healthProbe": {
                "const": "passed"
              }
            }
          },
          "checks": {
            "required": [
              "imageVerified",
              "trafficRestored"
            ],
            "properties": {
              "liveGcloudSession": {
                "const": true
              },
              "trafficPinned": {
                "const": true
              },
              "imageVerified": {
                "const": true
              },
              "trafficRestored": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
